# Spring Boot database configuration
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/mDosthi?useUnicode=true&characterEncoding=UTF-8
SPRING_DATASOURCE_USERNAME=mDosthi
SPRING_DATASOURCE_PASSWORD=change-me

# Application identity and security
IMEDIX_CENTER_CODE=VBCR019
SECRETKEY=replace-with-a-random-secret
LEGACY_API_BASE_URL=http://127.0.0.1:9090

# Local Ollama service
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_EN=llama3.2:3b
OLLAMA_MODEL_BN=llama3.2:3b
OLLAMA_LOG_DIR=./logs/chat
OLLAMA_LOG_PAYLOAD_ENABLED=true
OLLAMA_TTS_ENABLED=true
OLLAMA_TTS_MODEL=phonon
OLLAMA_TTS_VOICE=default
OLLAMA_TTS_LANGUAGE=en
OLLAMA_TTS_TIMEOUT=30000
OLLAMA_TTS_MAX_TEXT_LENGTH=12000
OLLAMA_TTS_MAX_CONCURRENT=2

# WhatsApp alert integration
IMEDIX_WHATSAPP_ALERT_RECIPIENT=replace-with-country-code-and-number
IMEDIX_WHATSAPP_ACCESS_TOKEN=replace-with-access-token
IMEDIX_WHATSAPP_PHONE_NUMBER_ID=replace-with-phone-number-id
IMEDIX_WHATSAPP_VERIFY_TOKEN=replace-with-verify-token

# Local MySQL container (docker compose up -d mysql).
# The root password is for administration; Compose provisions the API account
# above from SPRING_DATASOURCE_USERNAME and SPRING_DATASOURCE_PASSWORD.
MYSQL_ROOT_PASSWORD=change-me
MYSQL_DATABASE=mDosthi

# Python annotation package (optional)
ANNOTATE_LOG_DIR=annotate_logs
ANNOTATE_PATIENTS_DIR=data/patients

# Legacy Java runtime overrides (optional; gblinfo.inf remains the fallback)
LEGACY_DB_URL=jdbc:mysql://localhost:3306/mDosthi?useUnicode=true&characterEncoding=UTF-8
# Docker Compose uses this schema name for the legacy RMI service.
LEGACY_DB_DATABASE=mDosthi
LEGACY_DB_USERNAME=mDosthi
LEGACY_DB_PASSWORD=change-me
LEGACY_TEMP_DIR=./runtime-data/temp
LEGACY_FTP_USERNAME=replace-with-ftp-user
LEGACY_FTP_PASSWORD=
LEGACY_SYSTEM_LOG_DIR=./runtime-data/SystemLog
LEGACY_SQL_LOG_DIR=./runtime-data/GenSqlLog
LEGACY_JAVA_XMS=128M
LEGACY_JAVA_XMX=512M

# Docker app targets (optional; use your LAN address for a physical Android device).
FLUTTER_API_HOST=localhost:8081
ANDROID_API_HOST=10.0.2.2:9090
# Reverse-DNS prefix for the generated Android application ID.
ANDROID_ORG=com.example
FLUTTER_WEB_PORT=8081
LEGACY_WEB_PORT=8080
API_PORT=9090
MYSQL_PORT=3306
