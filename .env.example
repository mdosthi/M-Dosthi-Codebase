# Spring Boot database configuration
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/mDosthi?useUnicode=true&characterEncoding=UTF-8
SPRING_DATASOURCE_USERNAME=mdosthi_app
SPRING_DATASOURCE_PASSWORD=replace-with-strong-db-password

# Application identity and security
IMEDIX_CENTER_CODE=
SECRETKEY=replace-with-base64-jwt-secret
LEGACY_API_BASE_URL=http://127.0.0.1:9090

# Local Ollama service
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_EN=llama3.2:3b
OLLAMA_MODEL_BN=llama3.2:3b
OLLAMA_LOG_DIR=./logs/chat
OLLAMA_LOG_PAYLOAD_ENABLED=true

# WhatsApp alert integration
IMEDIX_WHATSAPP_ALERT_RECIPIENT=replace-with-country-code-and-number
IMEDIX_WHATSAPP_ACCESS_TOKEN=replace-with-meta-whatsapp-access-token
IMEDIX_WHATSAPP_PHONE_NUMBER_ID=replace-with-whatsapp-phone-number-id
IMEDIX_WHATSAPP_VERIFY_TOKEN=replace-with-whatsapp-verify-token

# Local MySQL administration
# The root password is for administration; scripts/provision-api-db-user.sh provisions
# the API account above from SPRING_DATASOURCE_USERNAME and SPRING_DATASOURCE_PASSWORD.
MYSQL_ROOT_PASSWORD=replace-with-mysql-root-password
MYSQL_DATABASE=mDosthi

# Python annotation package (optional)
ANNOTATE_LOG_DIR=annotate_logs
ANNOTATE_PATIENTS_DIR=data/patients
ANNOTATE_DB_PASS=
GROQ_API_KEY=
DEEPINFRA_API_KEY=

# Legacy Java runtime overrides (optional; gblinfo.inf remains the fallback)
LEGACY_DB_URL=jdbc:mysql://localhost:3306/your-database?useUnicode=true&characterEncoding=UTF-8
LEGACY_DB_USERNAME=root
LEGACY_DB_PASSWORD=replace-with-legacy-db-password
LEGACY_TEMP_DIR=./runtime-data/temp
LEGACY_FTP_USERNAME=your-ftp-user
LEGACY_FTP_PASSWORD=
LEGACY_SYSTEM_LOG_DIR=./runtime-data/SystemLog
LEGACY_SQL_LOG_DIR=./runtime-data/GenSqlLog
LEGACY_JAVA_XMS=128M
LEGACY_JAVA_XMX=512M
