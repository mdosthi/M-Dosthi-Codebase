# Jars: ignored by default, but the legacy stack and bundled Tomcat depend on these checked-in libraries
*.jar
*.war
!tools/tomcat9/bin/*.jar
!tools/tomcat9/lib/*.jar
!tools/tomcat9/webapps/**/*.jar
!tools/tomcat9/webapps/**/*.war
!tools/tomcat9/webapps/**/*.class
!services/legacy/external-lib/**/*.jar
!services/legacy/runtime/lib/**/*.jar
!services/legacy/runtime/*.jar
!apps/web/WEB-INF/lib/**/*.jar
!**/gradle/wrapper/*.jar
!**/.mvn/wrapper/*.jar

# Legacy runtime output
services/legacy/runtime/SystemLog/
services/legacy/runtime/GenSqlLog/
services/legacy/runtime/temp/
services/legacy/runtime/Backup/
services/legacy/runtime/runtime-data/
