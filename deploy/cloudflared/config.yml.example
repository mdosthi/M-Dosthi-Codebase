tunnel: YOUR_TUNNEL_ID
# Absolute path to the tunnel credentials file, e.g.
#   macOS:   /Users/you/.cloudflared/YOUR_TUNNEL_ID.json
#   Linux:   /home/you/.cloudflared/YOUR_TUNNEL_ID.json
#   Windows: C:\Users\you\.cloudflared\YOUR_TUNNEL_ID.json
credentials-file: /ABSOLUTE/PATH/TO/YOUR_TUNNEL_ID.json
ingress:
  - hostname: mdosthi.app
    service: http://localhost:8081
  - service: http_status:404
