<%@page contentType="text/html" import="imedix.cook"%>
<%
  cook monitoringCook = new cook();
  String monitoringPatientId = monitoringCook.getCookieValue("patid", request.getCookies());
  if (monitoringPatientId == null || monitoringPatientId.trim().isEmpty()) monitoringPatientId = monitoringCook.getCookieValue("userid", request.getCookies());
  if (monitoringPatientId == null) monitoringPatientId = "";
  String monitoringPatientIdHtml = monitoringPatientId.replace("&", "&amp;").replace("\"", "&quot;").replace("<", "&lt;").replace(">", "&gt;");
%>
<link rel="stylesheet" href="<%=request.getContextPath()%>/style/patient-monitoring.css">
<script src="<%=request.getContextPath()%>/includes/patient-monitoring-api.js"></script>
<div class="patient-monitoring" data-patient-id="<%=monitoringPatientIdHtml%>">
  <div class="monitoring-header"><h2>Patient Monitoring / Well-being</h2><p class="text-muted">Record information you choose to share with your healthcare team.</p></div>
  <div id="patient-monitoring-message" class="alert" role="status" aria-live="polite" style="display:none"></div>
  <div class="row">
    <div class="col-md-6"><section class="panel monitoring-card" aria-labelledby="sleep-heading"><div class="panel-heading"><h3 id="sleep-heading" class="panel-title">Sleep Hygiene</h3></div><div class="panel-body"><form id="sleep-form" novalidate><div class="row"><div class="col-sm-6 form-group"><label for="sleep-date">Sleep date</label><input class="form-control" type="date" id="sleep-date" required></div><div class="col-sm-3 form-group"><label for="bedtime">Bedtime</label><input class="form-control" type="time" id="bedtime"></div><div class="col-sm-3 form-group"><label for="wake-time">Wake-up time</label><input class="form-control" type="time" id="wake-time"></div></div><div class="row"><div class="col-sm-4 form-group"><label for="sleep-duration">Duration (hours)</label><input class="form-control" type="number" id="sleep-duration" min="0" max="24" step="0.25"></div><div class="col-sm-4 form-group"><label for="sleep-quality">Sleep quality</label><select class="form-control" id="sleep-quality"><option value="">Select</option><option>Very Poor</option><option>Poor</option><option>Fair</option><option>Good</option><option>Very Good</option></select></div><div class="col-sm-4 form-group"><label for="awakenings">Night awakenings</label><input class="form-control" type="number" id="awakenings" min="0" max="50"></div></div><div class="checkbox"><label><input type="checkbox" id="difficulty-sleeping"> Difficulty sleeping</label></div><div class="form-group"><label for="sleep-notes">Notes</label><textarea class="form-control" id="sleep-notes" rows="2" maxlength="1000"></textarea></div><button class="btn btn-primary" type="submit">Save Sleep Record</button><span id="sleep-error" class="help-block" role="alert"></span></form><div id="sleep-history" class="monitoring-history"><div class="monitoring-loading">Loading monitoring data...</div></div></div></section></div>
    <div class="col-md-6"><section class="panel monitoring-card" aria-labelledby="mood-heading"><div class="panel-heading"><h3 id="mood-heading" class="panel-title">Mood</h3></div><div class="panel-body"><form id="mood-form"><fieldset><legend class="sr-only">How are you feeling today?</legend><p><strong>How are you feeling today?</strong></p><div class="form-group"><label class="radio-inline"><input type="radio" name="mood" value="Very Low"> Very Low</label><label class="radio-inline"><input type="radio" name="mood" value="Low"> Low</label><label class="radio-inline"><input type="radio" name="mood" value="Neutral"> Neutral</label><label class="radio-inline"><input type="radio" name="mood" value="Good"> Good</label><label class="radio-inline"><input type="radio" name="mood" value="Very Good"> Very Good</label></div></fieldset><div class="form-group"><label for="mood-intensity">Mood intensity (optional)</label><input class="form-control" type="number" id="mood-intensity" min="0" max="10"></div><div class="form-group"><label for="mood-notes">Notes (optional)</label><textarea class="form-control" id="mood-notes" rows="3" maxlength="1000"></textarea></div><button class="btn btn-primary" type="submit">Record Mood</button><span id="mood-error" class="help-block" role="alert"></span></form><div id="mood-history" class="monitoring-history"><div class="monitoring-loading">Loading monitoring data...</div></div></div></section></div>
  </div>
  <section class="panel monitoring-card" aria-labelledby="activity-heading"><div class="panel-heading"><h3 id="activity-heading" class="panel-title">Activity Scheduling</h3></div><div class="panel-body"><p class="text-muted">Plan meaningful activities and record what you complete.</p><form id="activity-form" class="row" novalidate><div class="col-md-3 form-group"><label for="activity-name">Activity name</label><input class="form-control" id="activity-name" maxlength="200" required></div><div class="col-md-2 form-group"><label for="activity-category">Category</label><select class="form-control" id="activity-category" required><option value="">Select</option><option>Walking</option><option>Exercise</option><option>Relaxation</option><option>Social Activity</option><option>Hobby</option><option>Daily Routine</option><option>Other</option></select></div><div class="col-md-2 form-group"><label for="activity-date">Date</label><input class="form-control" type="date" id="activity-date" required></div><div class="col-md-2 form-group"><label for="activity-time">Start time</label><input class="form-control" type="time" id="activity-time" required></div><div class="col-md-2 form-group"><label for="activity-duration">Duration (minutes)</label><input class="form-control" type="number" id="activity-duration" min="1" max="1440" required></div><div class="col-md-1 form-group"><label for="activity-status">Status</label><select class="form-control" id="activity-status"><option>Scheduled</option><option>Completed</option><option>Skipped</option></select></div><div class="col-md-12 form-group"><label for="activity-notes">Notes</label><textarea class="form-control" id="activity-notes" rows="2" maxlength="1000"></textarea></div><div class="col-md-12"><button class="btn btn-primary" type="submit">Add Activity</button><span id="activity-error" class="help-block" role="alert"></span></div></form><div id="activity-list" class="monitoring-history"><div class="monitoring-loading">Loading monitoring data...</div></div></div></section>
  <div class="row"><div class="col-md-6"><section class="panel monitoring-card education-card"><div class="panel-body"><h3>Understanding Mood &amp; Activity</h3><p>Tracking mood can help you notice changes over time. Recording activities can support daily structure and make it easier to remember meaningful things you have done.</p><p>Persistent concerns should be discussed with your healthcare team. This information is for reflection and communication, not diagnosis.</p></section></div><div class="col-md-6"><section class="panel monitoring-card education-card"><div class="panel-body"><h3>What is CBT?</h3><p>Cognitive behavioural therapy (CBT) is a structured psychological intervention that explores connections between thoughts, feelings and behaviours.</p><p>It can involve identifying unhelpful thought patterns and practising new ways to respond with appropriate professional guidance.</p></section></div></div>
  <section class="panel monitoring-card" aria-labelledby="distortions-heading"><div class="panel-heading"><h3 id="distortions-heading" class="panel-title">Understanding Cognitive Distortions</h3></div><div class="panel-body"><p>These educational examples are not an assessment or diagnosis of your thoughts.</p><div class="row" id="distortion-cards"><div class="col-md-4"><div class="panel panel-default education-card"><div class="panel-body"><h4>All-or-Nothing Thinking</h4><p>Seeing situations as only complete success or complete failure.</p><p><strong>Example:</strong> “I missed one day, so I have failed.”</p><p><strong>Alternative:</strong> “One day does not define the whole effort.”</p></div></div></div><div class="col-md-4"><div class="panel panel-default education-card"><div class="panel-body"><h4>Overgeneralization</h4><p>Applying one difficult event to every similar situation.</p><p><strong>Example:</strong> “That conversation went badly, so they always will.”</p><p><strong>Alternative:</strong> “This was one conversation; future ones may differ.”</p></div></div></div><div class="col-md-4"><div class="panel panel-default education-card"><div class="panel-body"><h4>Catastrophizing</h4><p>Expecting the worst possible outcome.</p><p><strong>Example:</strong> “This setback means everything will go wrong.”</p><p><strong>Alternative:</strong> “What outcomes are possible, and what support is available?”</p></div></div></div><div class="col-md-4"><div class="panel panel-default education-card"><div class="panel-body"><h4>Mind Reading</h4><p>Assuming you know what another person thinks.</p><p><strong>Example:</strong> “They did not reply because they are upset with me.”</p><p><strong>Alternative:</strong> “I do not know their reason yet.”</p></div></div></div><div class="col-md-4"><div class="panel panel-default education-card"><div class="panel-body"><h4>Fortune Telling</h4><p>Predicting a negative future as if it is certain.</p><p><strong>Example:</strong> “This will definitely get worse.”</p><p><strong>Alternative:</strong> “The future is uncertain; I can focus on the next step.”</p></div></div></div><div class="col-md-4"><div class="panel panel-default education-card"><div class="panel-body"><h4>Personalization</h4><p>Taking responsibility for events outside your control.</p><p><strong>Example:</strong> “It is my fault that the plan changed.”</p><p><strong>Alternative:</strong> “Several factors may have contributed.”</p></div></div></div></div></div></section>
</div>
<script type="text/plain">
(function ($) {
  'use strict';
  var root = $('.patient-monitoring').last(), patientId = root.data('patient-id'), service = window.MDosthiMonitoringService;
  function message(text, type) { $('#patient-monitoring-message').removeClass('alert-success alert-danger').addClass('alert-' + type).text(text).show(); }
  function escapeHtml(value) { return $('<div>').text(value == null ? '' : value).html(); }
  function renderRows(target, records, columns, empty) { if (!records || !records.length) { $(target).html('<div class="monitoring-empty">' + empty + '</div>'); return; } var html = '<div class="table-responsive"><table class="table table-striped"><thead><tr>' + columns.map(function(c){return '<th>'+c.label+'</th>';}).join('') + '</tr></thead><tbody>'; records.forEach(function(r){html += '<tr>' + columns.map(function(c){return '<td>'+escapeHtml(r[c.key])+'</td>';}).join('') + '</tr>';}); $(target).html(html + '</tbody></table></div>'); }
  function load() { service.getSleepRecords(patientId).done(function(d){renderRows('#sleep-history', d && d.records, [{key:'sleepDate',label:'Date'},{key:'duration',label:'Duration'},{key:'quality',label:'Quality'}], 'No records available yet.');}).fail(function(){$('#sleep-history').html('<div class="monitoring-error">Unable to load monitoring data. Please try again.</div>');}); service.getMoodRecords(patientId).done(function(d){renderRows('#mood-history', d && d.records, [{key:'date',label:'Date'},{key:'mood',label:'Mood'},{key:'notes',label:'Notes'}], 'No records available yet.');}).fail(function(){$('#mood-history').html('<div class="monitoring-error">Unable to load monitoring data. Please try again.</div>');}); service.getActivities(patientId).done(function(d){renderRows('#activity-list', d && d.records, [{key:'name',label:'Activity'},{key:'date',label:'Date'},{key:'startTime',label:'Start time'},{key:'duration',label:'Duration'},{key:'status',label:'Status'}], 'No records available yet.');}).fail(function(){$('#activity-list').html('<div class="monitoring-error">Unable to load monitoring data. Please try again.</div>');}); }
  $('#sleep-form').on('submit', function(e){e.preventDefault();var f=this;if(!f['sleep-date'].value){$('#sleep-error').text('Sleep date is required.');return;}if(f['sleep-duration'].value && (f['sleep-duration'].value<0 || f['sleep-duration'].value>24)){$('#sleep-error').text('Enter a duration between 0 and 24 hours.');return;}service.createSleepRecord(patientId,{sleepDate:f['sleep-date'].value,bedtime:f.bedtime.value,wakeTime:f['wake-time'].value,duration:f['sleep-duration'].value,quality:f['sleep-quality'].value,awakenings:f.awakenings.value,difficultySleeping:$('#difficulty-sleeping').prop('checked'),notes:$('#sleep-notes').val()}).done(function(){message('Information saved successfully.','success');f.reset();load();}).fail(function(){message('Unable to save monitoring data. Please try again.','danger');});});
  $('#mood-form').on('submit', function(e){e.preventDefault();var mood=$('input[name="mood"]:checked').val();if(!mood){$('#mood-error').text('Select a mood value.');return;}service.createMoodRecord(patientId,{mood:mood,intensity:$('#mood-intensity').val(),notes:$('#mood-notes').val()}).done(function(){message('Your mood has been recorded.','success');$('#mood-form')[0].reset();load();}).fail(function(){message('Unable to save monitoring data. Please try again.','danger');});});
  $('#activity-form').on('submit', function(e){e.preventDefault();var f=this;if(!f['activity-name'].value.trim()||!f['activity-category'].value||!f['activity-date'].value||!f['activity-time'].value||!f['activity-duration'].value){$('#activity-error').text('Activity name, category, date, time, and duration are required.');return;}service.createActivity(patientId,{name:f['activity-name'].value,category:f['activity-category'].value,date:f['activity-date'].value,startTime:f['activity-time'].value,duration:f['activity-duration'].value,status:f['activity-status'].value,notes:$('#activity-notes').val()}).done(function(){message('Information saved successfully.','success');f.reset();load();}).fail(function(){message('Unable to save monitoring data. Please try again.','danger');});});
  load();
}(jQuery));
</script>
<script src="<%=request.getContextPath()%>/includes/patient-monitoring-patient.js"></script>